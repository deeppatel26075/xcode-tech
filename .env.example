# SMTP Configuration for contact form email routing
# Copy this file to a new file named `.env.local` and fill in your credentials.

# 1. SMTP Server Host (e.g. smtp.zoho.in, smtp.zoho.com, smtp.gmail.com)
SMTP_HOST=smtp.zoho.in

# 2. SMTP Server Port (465 is standard for secure SSL, 587 is standard for TLS)
SMTP_PORT=465

# 3. SMTP Auth Username (usually your domain email address)
SMTP_USER=contact@xcodetech.in

# 4. SMTP Auth Password (your email password, or an App Password if using 2FA)
SMTP_PASSWORD=your_actual_email_password_or_app_password

# 5. Inquiry Recipient Email (defaults to admin@xcodetech.in if not specified)
SMTP_TO=admin@xcodetech.in

